{
  "name": "quad-campus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env backend/index.mjs",
    "build": "node scripts/build-production.mjs",
    "start": "node backend/index.mjs",
    "test": "npm run test:backend && npm run test:legacy",
    "check": "npm test && npm --prefix apps/mobile run typecheck && npm --prefix apps/mobile test && npm run build",
    "format": "prettier --write backend scripts apps/mobile/src apps/mobile/App.tsx docs README.md package.json render.yaml Dockerfile .github/workflows",
    "mobile": "npm --prefix apps/mobile start",
    "mobile:web": "npm --prefix apps/mobile run web",
    "mobile:check": "npm --prefix apps/mobile run check",
    "build:legacy": "tsc --noEmit && vite build",
    "demo:web": "node server/index.js --dev",
    "test:backend": "node --test backend/tests/*.test.mjs",
    "test:legacy": "node --test tests/*.test.js",
    "check:config": "node scripts/check-config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "leaflet": "^1.9.4",
    "nodemailer": "^10.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
