# Default: real authentication, no fictional accounts or local data fallback.
EXPO_PUBLIC_DEMO_MODE=false
# Web production is same-origin; leave this empty for the Docker web build.
# Native builds require your deployed HTTPS API origin, without a trailing slash.
EXPO_PUBLIC_API_URL=
# Build-time, Android native map SDK key. Restrict it to the Android package/signing certificate.
ANDROID_GOOGLE_MAPS_API_KEY=
