# Backend development. Production secrets go in the hosting dashboard, never Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://localhost:8080
QUAD_DB=./data/production.sqlite
AUTH_SECRET=replace-with-at-least-32-random-characters
SCHOOL_EMAIL_DOMAINS=rutgers.edu,scarletmail.rutgers.edu
# First moderator must verify an approved Rutgers email like every other account.
ADMIN_EMAILS=
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Production requires HTTPS APP_ORIGIN (or Render's RENDER_EXTERNAL_URL) and /data/quad.sqlite.
# Set TRUST_PROXY=1 only behind the hosting reverse proxy.
TRUST_PROXY=0
# Encrypted S3-compatible offsite backup, automatically every six hours, retention 30 days.
BACKUP_BUCKET=
BACKUP_REGION=us-east-1
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_KEY=
# A public browser tile URL, with provider-required attribution. Respect provider usage terms.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
